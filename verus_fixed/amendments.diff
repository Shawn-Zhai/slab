+/// Vacating slots does not raise the count: if every slot vacant in `pre` is vacant in `post`,
+/// `post` has at most as many occupied slots as `pre`.
+pub proof fn lemma_num_occupied_vacated<T>(pre: Seq<Option<T>>, post: Seq<Option<T>>)
+    requires
+        post.len() == pre.len(),
+        forall|k: int| 0 <= k < pre.len() && (#[trigger] pre[k]) is None ==> post[k] is None,
+    ensures
+        num_occupied(post) <= num_occupied(pre),
+    decreases pre.len(),
+{
+    if pre.len() > 0 {
+        let (t1, t2) = (pre.drop_last(), post.drop_last());
+        assert forall|k: int| 0 <= k < t1.len() && (#[trigger] t1[k]) is None implies t2[k] is None by {
+            assert(pre[k] is None);
+        }
+        lemma_num_occupied_vacated(t1, t2);
+        assert(pre.last() is None ==> post.last() is None);
+    }
+}
