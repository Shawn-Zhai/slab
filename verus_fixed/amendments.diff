+// ============================================================================== Iter
+
+// The gold `Iter` model read in terms of the verified crate: the `(key, &value)` pairs of Claude's
+// `remaining()`, with keys as `int` and values dereferenced. It is written with `iter_items` of
+// the fields, which is the body of `remaining()`, because `remaining()` is prophetic and a gold
+// view must not be.
+// @interpret iter_remaining
+pub(crate) closed spec fn iter_remaining<'a, T>(it: &crate::Iter<'a, T>) -> Seq<(int, T)> {
+    iter_items(it.entries@, it.front).map_values(|p: (usize, &T)| (p.0 as int, *p.1))
+}
+
+// Claude's `(key, value)` pairs with `int` keys, as the gold model lists them.
+spec fn int_pairs<T>(p: Seq<(usize, T)>) -> Seq<(int, T)> {
+    p.map_values(|q: (usize, T)| (q.0 as int, q.1))
+}
+
+// Claude's pairs of the occupied slots below `n` are the gold pairs of those slots.
+proof fn lemma_iter_pairs<T>(m: SlabModel<T>, n: int)
+    requires
+        0 <= n <= m.slots.len(),
+        m.slots.len() <= usize::MAX,
+    ensures
+        int_pairs(occupied_pairs(m.slots.subrange(0, n), 0)) == Seq::new(n as nat, |i: int| i).filter(
+            |i: int| m.slots[i].is_some(),
+        ).map_values(|i: int| (i, m.slots[i].unwrap())),
+    decreases n,
+{
+    reveal(Seq::filter);
+    let s = Seq::new(n as nat, |i: int| i);
+    let f = |i: int| (i, m.slots[i].unwrap());
+    if n > 0 {
+        lemma_iter_pairs(m, n - 1);
+        let s0 = Seq::new((n - 1) as nat, |i: int| i);
+        assert(s.drop_last() =~= s0);
+        let f0 = s0.filter(|i: int| m.slots[i].is_some());
+        let sub0 = m.slots.subrange(0, n - 1);
+        assert(m.slots.subrange(0, n).drop_last() =~= sub0);
+        let head = occupied_pairs(sub0, 0);
+        if m.slots[n - 1].is_some() {
+            assert(s.filter(|i: int| m.slots[i].is_some()) == f0.push(n - 1));
+            assert(f0.push(n - 1).map_values(f) =~= f0.map_values(f).push(f(n - 1)));
+            assert(int_pairs(head + seq![((n - 1) as usize, m.slots[n - 1].unwrap())]) =~= int_pairs(
+                head,
+            ).push(f(n - 1)));
+        } else {
+            assert(s.filter(|i: int| m.slots[i].is_some()) == f0);
+            assert(head + Seq::<(usize, T)>::empty() =~= head);
+        }
+    } else {
+        assert(int_pairs(occupied_pairs(m.slots.subrange(0, 0), 0)) =~= Seq::<(int, T)>::empty());
+    }
+}
