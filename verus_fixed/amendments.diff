+    let len = slab.len();
+    let mut it = slab.iter();
+    let (lo, hi) = it.size_hint();
+    assert(lo == len && hi == Some(len));
+
+    let first = it.next();
+    let (lo, hi) = it.size_hint();
+    if len > 0 {
+        assert(first is Some && lo == len - 1 && hi == Some(lo));
+    } else {
+        assert(first is None && lo == 0 && hi == Some(0usize));
+    }
