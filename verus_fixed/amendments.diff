+def compute_placeholders(g):
+    """Viewed types whose view uses an uninterpreted function that no axiom covers."""
+    g.placeholder_types = set()
+    for name, it in g.views.items():
+        used = {g.toks[j].t for j in range(it.start, it.end)} & g.uninterp
+        if used - g.axiom_covered:
+            g.placeholder_types.add(name)
+
