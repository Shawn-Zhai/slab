+/// `slab[key] = value` stores the value, and the slab stays usable.
+fn example_index_mut() {
+    let mut slab: Slab<u64> = Slab::new();
+    let key = slab.insert(1);
+
+    slab[key] = 2;
+    let v = slab[key];
+    assert(v == 2);
+
+    let next = slab.insert(3);
+    assert(next == 1);
+}
